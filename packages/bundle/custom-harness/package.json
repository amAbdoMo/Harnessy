{
  "name": "@deepseek-ai/dsh-custom-harness",
  "description": "The product patch layer for the independent Harnessy browser profile",
  "version": "0.1.5-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amAbdoMo/Harnessy.git",
    "directory": "packages/bundle/custom-harness"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-authorization": "workspace:^",
    "@deepseek-ai/dsh-client-ui-brand-custom-harness": "workspace:^",
    "@deepseek-ai/dsh-client-ui-settings-subagents": "workspace:^",
    "@deepseek-ai/dsh-client-ui-workspace-brief": "workspace:^",
    "@deepseek-ai/dsh-model-capabilities": "workspace:^",
    "@deepseek-ai/dsh-skill-filesystem": "workspace:^",
    "@deepseek-ai/dsh-subagent-commandcode": "workspace:^",
    "@deepseek-ai/dsh-subagent-roster": "workspace:^",
    "@deepseek-ai/dsh-workspace-brief": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
