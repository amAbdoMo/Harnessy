<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@color/harnessy_surface">
    <TextView style="@style/Harnessy.Caption" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:labelFor="@+id/draft"
        android:text="@string/followup_label" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="bottom">
        <EditText android:id="@id/draft" style="@style/Harnessy.Input"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:gravity="top|start" android:minLines="2" android:maxLines="4" android:maxLength="8192"
            android:inputType="textCapSentences|textMultiLine|textNoSuggestions"
            android:imeOptions="flagNoExtractUi" android:hint="@string/followup_hint"
            android:importantForAutofill="no" android:saveEnabled="false" />
        <Button android:id="@+id/send" style="@style/Harnessy.Action"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="@string/send" android:enabled="false" />
    </LinearLayout>
    <TextView android:id="@+id/unknown_target" style="@style/Harnessy.Caption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textIsSelectable="true" android:visibility="gone" />
    <Button android:id="@+id/resolve_unknown" style="@style/Harnessy.Action"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/resolve_unknown" android:visibility="gone" />
    <TextView android:id="@+id/send_status" style="@style/Harnessy.Caption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite" />
</LinearLayout>
