<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/harnessy_base">
    <TextView android:id="@+id/session_title" style="@style/Harnessy.Title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp" android:maxLines="2" android:ellipsize="end" />
    <TextView android:id="@+id/feedback" style="@style/Harnessy.Caption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp" android:background="@color/harnessy_warning_bg"
        android:textColor="@color/harnessy_warning" android:accessibilityLiveRegion="polite" />
    <TextView android:id="@+id/transcript_empty" style="@style/Harnessy.Caption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:padding="12dp" android:text="@string/transcript_empty" />
    <ListView android:id="@+id/transcript" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:divider="@null"
        android:transcriptMode="disabled" android:paddingStart="12dp"
        android:paddingEnd="12dp" android:clipToPadding="false" />
    <Button android:id="@+id/load_history" style="@style/Harnessy.Action"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/load_history" android:visibility="gone" />
    <include layout="@layout/composer" />
</LinearLayout>
