<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="12dp"
    android:background="@color/harnessy_layer">
    <TextView style="@style/Harnessy.Caption" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingTop="8dp"
        android:paddingBottom="4dp" android:text="@string/sessions" />
    <TextView android:id="@+id/sessions_empty" style="@style/Harnessy.Caption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/sessions_empty" />
    <ListView android:id="@+id/sessions" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:dividerHeight="1dp"
        android:divider="@color/harnessy_border" />
    <Button android:id="@+id/load_sessions" style="@style/Harnessy.Action"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/load_sessions" android:visibility="gone" />
</LinearLayout>
