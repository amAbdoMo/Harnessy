<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:padding="12dp" android:layout_marginBottom="8dp" android:orientation="vertical">
    <TextView android:id="@+id/row_role" style="@style/Harnessy.Caption"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingBottom="6dp" android:fontFamily="sans-serif-medium" />
    <TextView android:id="@+id/row_text" style="@style/Harnessy.Body"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textIsSelectable="true" android:autoLink="none" />
</LinearLayout>
