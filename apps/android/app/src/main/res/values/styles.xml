<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Harnessy" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorAccent">@color/harnessy_accent</item>
        <item name="android:windowBackground">@color/harnessy_base</item>
        <item name="android:colorBackground">@color/harnessy_base</item>
        <item name="android:textColorPrimary">@color/harnessy_primary</item>
        <item name="android:textColorSecondary">@color/harnessy_secondary</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/harnessy_base</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
    <style name="Theme.Harnessy" parent="@style/Base.Theme.Harnessy" />
    <style name="Harnessy.Title" parent="">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/harnessy_primary</item>
    </style>
    <style name="Harnessy.Body" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/harnessy_primary</item>
    </style>
    <style name="Harnessy.Caption" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/harnessy_secondary</item>
    </style>
    <style name="Harnessy.Action" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/action_text</item>
    </style>
    <style name="Harnessy.Input" parent="android:style/Widget.Material.EditText">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/harnessy_primary</item>
        <item name="android:textColorHint">@color/harnessy_secondary</item>
        <item name="android:backgroundTint">@color/harnessy_accent</item>
    </style>
</resources>
