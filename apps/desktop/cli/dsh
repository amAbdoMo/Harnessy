#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
CUSTOM_HARNESS_DATA_DIR="$HOME/Library/Application Support/CustomHarness"
DSH_HOME="$CUSTOM_HARNESS_DATA_DIR/Harness"
DSH_AGENTS_HOME="$CUSTOM_HARNESS_DATA_DIR/Agents"
CUSTOM_HARNESS_AGENTS_DIR="$DSH_AGENTS_HOME"
CUSTOM_HARNESS_LOG_DIR="$CUSTOM_HARNESS_DATA_DIR/Logs"
CUSTOM_HARNESS_CACHE_DIR="$CUSTOM_HARNESS_DATA_DIR/Cache"
export CUSTOM_HARNESS_DATA_DIR DSH_HOME DSH_AGENTS_HOME CUSTOM_HARNESS_AGENTS_DIR CUSTOM_HARNESS_LOG_DIR CUSTOM_HARNESS_CACHE_DIR
ELECTRON_RUN_AS_NODE=1 exec "$resources/../MacOS/Harnessy" --expose-internals "$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js" "$@"
